{
  "name": "spraxium",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter=\"./packages/*\" run dev",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format . --write",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky",
    "typecheck": "pnpm -r --filter=\"./packages/*\" exec tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
