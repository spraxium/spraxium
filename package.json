{
  "name": "spraxium",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter=\"./packages/*\" run dev",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format . --write",
    "changeset": "changeset",
    "version": "changeset version && biome format --write packages apps",
    "release": "pnpm run build && changeset publish --provenance --access public",
    "prepare": "husky",
    "typecheck": "pnpm -r --filter=\"./packages/*\" exec tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "tsdown": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.25.0"
}
