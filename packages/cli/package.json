{
  "name": "@spraxium/cli",
  "version": "0.3.0",
  "private": false,
  "description": "Spraxium CLI for project scaffolding, module generation and developer tooling",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "spraxium",
    "cli",
    "scaffolding",
    "code-generator",
    "module-generator",
    "bot-framework",
    "typescript",
    "create-bot",
    "project-template",
    "developer-tools",
    "monorepo"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "spraxium": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "@spraxium/logger": "workspace:*",
    "@swc/core": "^1.15.18",
    "commander": "^13.1.0",
    "execa": "^9.5.0",
    "giget": "^3.2.0",
    "minimatch": "^10.0.1",
    "shell-quote": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/shell-quote": "^1.7.5",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spraxium/spraxium",
    "directory": "packages/cli"
  }
