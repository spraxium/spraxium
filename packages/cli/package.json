{
  "name": "@spraxium/cli",
  "version": "0.10.0",
  "private": false,
  "description": "Spraxium CLI for project scaffolding, module generation and developer tooling",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "spraxium",
    "cli",
    "scaffolding",
    "code-generator",
    "module-generator",
    "bot-framework",
    "typescript",
    "create-bot",
    "project-template",
    "developer-tools",
    "monorepo"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
