    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
