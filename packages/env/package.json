{
  "name": "@spraxium/env",
  "version": "0.3.2",
  "private": false,
  "description": "Typed environment variable validation with class decorators and clear startup errors",
  "keywords": [
    "discord",
    "discord-bot",
    "spraxium",
    "typescript",
    "decorators",
    "environment-variables",
    "env-validation",
    "dotenv",
    "configuration",
    "class-validator",
    "bot-framework",
    "startup-validation",
    "type-safe-env"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@spraxium/logger": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spraxium/spraxium",
    "directory": "packages/env"
  }
}
