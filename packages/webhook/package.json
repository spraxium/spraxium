{
  "name": "@spraxium/webhook",
  "version": "0.9.0",
  "private": false,
  "description": "Decorator-based Discord webhook management for Spraxium bots with a rich send API",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "spraxium",
    "typescript",
    "decorators",
    "webhook",
    "discord-webhook",
    "webhook-management",
    "send-webhook",
    "bot-framework",
    "rich-embeds"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@spraxium/logger": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@spraxium/common": "*",
    "@spraxium/core": "*",
    "@spraxium/logger": "*",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@spraxium/common": "workspace:*",
    "@spraxium/core": "workspace:*",
    "@spraxium/logger": "workspace:*",
    "@types/node": "^22.20.1",
    "discord.js": "^14.28.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spraxium/spraxium",
    "directory": "packages/webhook"
  }
}
