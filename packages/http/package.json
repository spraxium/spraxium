{
  "name": "@spraxium/http",
  "version": "0.9.0",
  "private": false,
  "description": "Deprecated HTTP integration for Spraxium. A replacement is in development.",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "spraxium",
    "typescript",
    "decorators",
    "http",
    "rest-api",
    "hono",
    "web-server",
    "bot-api",
    "routes",
    "bot-framework",
    "api-layer"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hono": "^4.13.13",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@spraxium/common": "*",
    "@spraxium/core": "*",
    "@spraxium/logger": "*",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@spraxium/common": "workspace:*",
    "@spraxium/core": "workspace:*",
    "@spraxium/logger": "workspace:*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spraxium/spraxium",
    "directory": "packages/http"
  }
}
